{
  "manifest_version": 3,
  "name": "Yume - AI Subtitles",
  "version": "0.1.0",
  "description": "You Understand More Easily - Real-time AI subtitles for any video, fully local",
  "key": "",

  "browser_specific_settings": {
    "gecko": {
      "id": "yume-subtitles@pocketyume",
      "strict_min_version": "121.0"
    }
  },

  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],

  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],

  "background": {
    "service_worker": "js/background.js",
    "scripts": ["js/background.js"]
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "commands": {
    "toggle-subtitles": {
      "suggested_key": {
        "default": "Alt+Y",
        "mac": "Alt+Y"
      },
      "description": "Toggle subtitles on/off"
    }
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "js/bundled-fonts.js",
        "js/subtitle-window.js",
        "js/session.js",
        "js/content.js"
      ],
      "run_at": "document_end",
      "all_frames": false
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": ["css/content.css", "fonts/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
