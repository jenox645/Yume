# Yume .gitignore
# Only rules relevant to this project. No framework boilerplate.

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.venv/
venv/
env/
yume-env/

# ── IDE / Editor ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── Testing / Coverage ──
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Type / lint caches ──
.mypy_cache/
.pytype/
.ruff_cache/

# ── Yume: user config (each user has their own settings) ──
config/yume_config.json
yume_config_post_setup.json
yume_config_backup_*.json

# ── Yume: API token (generated per session, must never be committed) ──
.yume_token

# ── Yume: downloaded models (can be gigabytes) ──
models/translation/*.gguf
models/translation/*.bin

# ── Yume: runtime logs ──
logs/*.log
logs/*.txt

# ── Yume: downloaded tools (auto-installed by Pocket Yume CLI) ──
tools/yt-dlp
tools/yt-dlp.exe
tools/ffmpeg
tools/ffmpeg.exe
tools/ffprobe.exe
tools/deno
tools/deno.exe
tools/bgutil-ytdlp-pot-provider/

# ── Yume: banner image (referenced via GitHub raw URL in README) ──
# Already on remote — no need to re-download on every clone
assets/banner.png

# ── Node (ESLint dev tooling only) ──
node_modules/

# ── Analysis reports (generated by tools/analyze.py) ──
reports/
pyan_err.txt

# ── Dev tooling (not needed at runtime) ──
.editorconfig
.pre-commit-config.yaml
pyrightconfig.json
tools/analyze.py
tools/analyze-requirements.txt
extension/fonts/README.md

# ── Claude Code session data (machine-specific, not project docs) ──
.claude/
CLAUDE.md
Sunset_Blu_Swing.png
Transcribing.png
Yume Showcase.mp4
